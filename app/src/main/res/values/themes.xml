<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.AquaVera" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Main branding colors -->
        <item name="colorPrimary">@color/teal_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary_purple</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Status and Navigation Bars -->
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>

        <!-- Background -->
        <item name="android:windowBackground">@color/background_light_grey</item>

        <!-- Typography -->
        <item name="android:textColorPrimary">@color/dark_navy</item>
        <item name="android:textColorSecondary">@color/medium_grey</item>
    </style>
</resources>
