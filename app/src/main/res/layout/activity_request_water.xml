<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light_grey">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        android:background="@color/white">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:paddingTop="36dp"
            android:paddingBottom="8dp"
            android:background="@color/white"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/dark_navy"
            app:title="@string/title_request_water"
            app:titleCentered="false"
            app:titleTextColor="@color/dark_navy"
            app:titleMarginStart="16dp" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Crop Details -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="0dp"
                app:cardUseCompatPadding="true"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_crop_type"
                        android:textStyle="bold"
                        android:textColor="@color/dark_navy"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        app:hintEnabled="false"
                        app:boxBackgroundColor="@color/grey_light"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeColor="@color/grey_border"
                        app:boxStrokeWidthFocused="1dp">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/autoCropType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:hint="Select crop type"
                            android:textColor="@color/dark_navy"
                            android:textColorHint="@color/medium_grey"
                            android:padding="16dp"
                            android:popupBackground="@color/white"
                            app:simpleItemLayout="@layout/spinner_item_light" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_crop"
                        android:textStyle="bold"
                        android:textColor="@color/dark_navy"
                        android:textSize="14sp"
                        android:layout_marginBottom="8dp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCrop"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:enabled="false"
                        app:hintEnabled="false"
                        app:boxBackgroundColor="@color/grey_light"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeColor="@color/grey_border"
                        app:boxStrokeWidthFocused="1dp">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/autoCrop"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:hint="Select crop"
                            android:textColor="@color/dark_navy"
                            android:textColorHint="@color/medium_grey"
                            android:padding="16dp"
                            android:popupBackground="@color/white"
                            app:simpleItemLayout="@layout/spinner_item_light" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Season"
                        android:textStyle="bold"
                        android:textColor="@color/dark_navy"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleSeason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true"
                        android:layout_marginBottom="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnKharif"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Kharif"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            android:textColor="@color/dark_navy" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRabi"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Rabi"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            android:textColor="@color/dark_navy" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSummer"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Summer"
                            android:textAllCaps="false"
                            android:textSize="13sp"
                            android:textColor="@color/dark_navy" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Image Capture -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white"
                app:strokeWidth="0dp"
                app:cardUseCompatPadding="true"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_capture_image_req"
                        android:textStyle="bold"
                        android:textColor="@color/dark_navy"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        app:cardCornerRadius="8dp"
                        app:strokeWidth="1dp"
                        app:strokeColor="@color/grey_border"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/grey_light">
                        <ImageView
                            android:id="@+id/imgFarm"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerInside"
                            android:src="@android:drawable/ic_menu_camera"
                            android:padding="50dp"
                            app:tint="@color/teal_accent"
                            android:contentDescription="@string/desc_farm_image_preview"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Location not captured"
                        android:textColor="@color/medium_grey"
                        android:textSize="11sp"
                        android:lineSpacingExtra="4dp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnCaptureImage"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/btn_capture"
                        android:textAllCaps="false"
                        android:layout_marginTop="16dp"
                        android:textColor="@color/teal_accent"
                        style="@style/Widget.Material3.Button.TonalButton"
                        app:icon="@android:drawable/ic_menu_camera"
                        app:iconTint="@color/teal_accent"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Billing Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp"
                android:background="@drawable/bg_billing_row_green"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="4dp"
                android:layout_marginBottom="50dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="@string/label_billing"
                    android:textColor="@color/teal_accent"
                    android:textStyle="bold"
                    android:textSize="15sp"/>
                <TextView
                    android:id="@+id/tvBillingAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹0.0"
                    android:textColor="@color/teal_accent"
                    android:textStyle="bold"
                    android:textSize="18sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_submit"
                android:enabled="false"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="28dp"
                style="@style/Widget.Material3.Button"
                android:layout_marginBottom="60dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
